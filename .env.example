# Copy to .env and adjust for your environment.

# Directory containing the downloaded model folders.
MODEL_DIR=/models

# Hugging Face repository ids used for downloads and response metadata.
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL_ID=Qwen/Qwen3-Reranker-0.6B

# Optional explicit model directories (override MODEL_DIR/<repo name>).
# EMBEDDING_MODEL_PATH=/models/Qwen3-Embedding-0.6B
# RERANKER_MODEL_PATH=/models/Qwen3-Reranker-0.6B

# cpu, cuda, cuda:0, mps, ...
DEVICE=cpu

# PyTorch / batching tuning.
TORCH_NUM_THREADS=4
TORCH_NUM_INTEROP_THREADS=1
EMBEDDING_BATCH_SIZE=32
RERANK_BATCH_SIZE=4
RERANK_MAX_LENGTH=512

# HTTP server.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
